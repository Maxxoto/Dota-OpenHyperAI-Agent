# Copy to .env and fill in (never committed — see .gitignore).
# Used by out-of-game tooling: test/live_roundtrip.lua, npm run learn (T7).

# Groq API key from https://console.groq.com (free tier is enough)
GROQ_API_KEY=

# Any OpenAI-compatible model id on Groq — verify current ids at
# https://console.groq.com/docs (qwen family recommended for this project)
GROQ_MODEL=qwen/qwen3.8-27b
